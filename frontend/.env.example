# URL base de la API en produccion web o app movil compilada (ejemplo: https://tu-backend.onrender.com/api)
# En desarrollo local dejala vacia para usar el proxy de Vite (/api)
VITE_API_URL=

# URL publica de Socket.IO solo si usas un servidor WebSocket separado de VITE_API_URL
# En Render con puerto unico dejala vacia para conectar automatico a /socket.io/ en el mismo dominio
VITE_SOCKET_URL=

# Cambia a false para deshabilitar Socket.IO explicitamente y usar consulta periodica
VITE_SOCKET_ENABLED=true

# Muestra ayudas de demostracion (cuentas rapidas, tarjetas 4242/0002 y botones USB/emulador)
VITE_MODO_DEMO=false
