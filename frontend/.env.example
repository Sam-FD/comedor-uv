# URL base de la API en produccion web (ejemplo: https://tu-backend.onrender.com/api)
# En desarrollo local dejala vacia para usar el proxy de Vite (/api)
VITE_API_URL=

# URL publica de Socket.IO si el servidor permite un segundo puerto (ejemplo: http://tu-servidor:9092)
# Si usas un hosting gratuito de un solo puerto (como Render), dejala vacia
VITE_SOCKET_URL=

# Cambia a false para deshabilitar Socket.IO explicitamente y usar actualizacion automatica por consulta periodica
VITE_SOCKET_ENABLED=true
