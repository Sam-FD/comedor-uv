# URL base de la API para build web o movil (ejemplo: https://<servicio>.onrender.com/api)
# Vacia en desarrollo local para usar el proxy de Vite (/api)
VITE_API_URL=

# URL publica de Socket.IO solo si el servidor WebSocket corre aparte de VITE_API_URL
# Vacia cuando Nginx unifica API y /socket.io/ en el mismo dominio
VITE_SOCKET_URL=
